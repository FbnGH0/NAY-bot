# Copy to .env and fill in. NEVER commit .env.
TELEGRAM_TOKEN=
# Comma-separated user IDs who can get NAY'd. Empty = NAY anyone.
TELEGRAM_TARGETS=

DISCORD_TOKEN=
DISCORD_TARGETS=

# How long a question stays open (seconds), and min gap between auto NAYs per chat
WINDOW_SEC=604800
COOLDOWN_SEC=60
# Min gap between /nay or /wrongnay uses per person
NAY_COMMAND_COOLDOWN_SEC=60
